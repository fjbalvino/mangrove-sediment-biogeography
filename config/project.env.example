# Copy to config/project.env and edit the paths for your machine.
# Bash configuration: paths with spaces are supported. No data are downloaded here.
# Every default can also be supplied as an environment variable before sourcing.
export BIOGEOGRAPHY_BASE="${BIOGEOGRAPHY_BASE:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export MAGENTA_DATA_DIR="${MAGENTA_DATA_DIR:-$BIOGEOGRAPHY_BASE/data}"
export BIOGEOGRAPHY_RESULTS="${BIOGEOGRAPHY_RESULTS:-$BIOGEOGRAPHY_BASE/results}"
export PYTHON_BIN="${PYTHON_BIN:-python3}"
export R_BIN="${R_BIN:-Rscript}"

# Taxonomic inputs. Keep the 341-profile reference and 400-profile iCAMP separate.
export MAGENTA_PHYLOSEQ="${MAGENTA_PHYLOSEQ:-$MAGENTA_DATA_DIR/phyloseq_taxonomic.rds}"
export MAGENTA_METADATA_CSV="${MAGENTA_METADATA_CSV:-$MAGENTA_DATA_DIR/metadata_taxonomic.csv}"
export ALPHA_SAMPLE_MANIFEST="${ALPHA_SAMPLE_MANIFEST:-$BIOGEOGRAPHY_BASE/config/samples/taxonomic_accessions.txt}"
export CORE_SAMPLE_MANIFEST="${CORE_SAMPLE_MANIFEST:-$ALPHA_SAMPLE_MANIFEST}"
export ICAMP_PHYLOSEQ="${ICAMP_PHYLOSEQ:-$MAGENTA_DATA_DIR/icamp_taxonomic_counts.rds}"
export TREE_FILE="${TREE_FILE:-$MAGENTA_DATA_DIR/genus_phylogeny_GTDB_R226_bac120.newick}"
export ICAMP_SUMMARY_TSV="${ICAMP_SUMMARY_TSV:-$MAGENTA_DATA_DIR/reference_results/icamp/icamp_process_contributions.tsv}"

# Acquisition and profiling (needed only when starting from raw reads).
export MAGENTA_METADATA_CURATED="${MAGENTA_METADATA_CURATED:-$MAGENTA_DATA_DIR/metadata_curated.csv}"
export PHYLOSEQ_405="${PHYLOSEQ_405:-$MAGENTA_DATA_DIR/phyloseq_source.rds}"
export MAGENTA_PIPELINE_RESULTS="${MAGENTA_PIPELINE_RESULTS:-$BIOGEOGRAPHY_RESULTS/preprocessing}"
export MAGENTA_RAW_DIR="${MAGENTA_RAW_DIR:-$MAGENTA_DATA_DIR/raw}"
export MAGENTA_TRIMMED_DIR="${MAGENTA_TRIMMED_DIR:-$MAGENTA_DATA_DIR/trimmed}"
export MAGENTA_KRAKEN_DIR="${MAGENTA_KRAKEN_DIR:-$BIOGEOGRAPHY_RESULTS/kraken2}"
export KRAKEN2_DB="${KRAKEN2_DB:-$MAGENTA_DATA_DIR/references/kraken2}"
export NCBI_TAXDUMP_DIR="${NCBI_TAXDUMP_DIR:-$MAGENTA_DATA_DIR/references/taxdump}"
export DOWNLOAD_WORKERS="${DOWNLOAD_WORKERS:-2}"
export FASTQC_THREADS_PER_JOB="${FASTQC_THREADS_PER_JOB:-2}"
export FASTQC_WORKERS="${FASTQC_WORKERS:-2}"
export FASTP_THREADS_PER_SAMPLE="${FASTP_THREADS_PER_SAMPLE:-4}"
export FASTP_WORKERS="${FASTP_WORKERS:-1}"
export KRAKEN_THREADS_PER_SAMPLE="${KRAKEN_THREADS_PER_SAMPLE:-4}"
export KRAKEN_WORKERS="${KRAKEN_WORKERS:-1}"
export RAREFACTION_DEPTH="${RAREFACTION_DEPTH:-18145}"
export RANDOM_SEED="${RANDOM_SEED:-42}"
export EXPECTED_PHYLOSEQ_405_SAMPLES="${EXPECTED_PHYLOSEQ_405_SAMPLES:-405}"
export EXPECTED_PHYLOSEQ_405_TAXA="${EXPECTED_PHYLOSEQ_405_TAXA:-24045}"
export EXPECTED_TAXONOMIC_SAMPLES="${EXPECTED_TAXONOMIC_SAMPLES:-341}"

# Environmental assets must be obtained separately with their licenses/checksums.
export ENVIRONMENTAL_RESULTS="${ENVIRONMENTAL_RESULTS:-$BIOGEOGRAPHY_RESULTS/environmental}"
export ENVIRONMENTAL_CACHE="${ENVIRONMENTAL_CACHE:-$BIOGEOGRAPHY_BASE/cache/environmental}"
export ENVIRONMENTAL_METADATA_FINAL="${ENVIRONMENTAL_METADATA_FINAL:-$MAGENTA_METADATA_CSV}"
export HUMAN_FOOTPRINT_2020_TIF="${HUMAN_FOOTPRINT_2020_TIF:-$MAGENTA_DATA_DIR/references/human_footprint_2020.tif}"
export WORLDCLIM_BIO_DIR="${WORLDCLIM_BIO_DIR:-$MAGENTA_DATA_DIR/references/worldclim}"
export WORLDCLIM_BIO_PREFIX="${WORLDCLIM_BIO_PREFIX:-}"
export MEOW_VECTOR="${MEOW_VECTOR:-$MAGENTA_DATA_DIR/references/meow.gpkg}"
export COASTAL_ANCHOR_MAX_M="${COASTAL_ANCHOR_MAX_M:-2000}"
export GBIF_WORKERS="${GBIF_WORKERS:-2}"
export GBIF_GLOBAL_RPS="${GBIF_GLOBAL_RPS:-1}"
export SOILGRIDS_GLOBAL_RPS="${SOILGRIDS_GLOBAL_RPS:-0.5}"

# Functional analyses and external basemap.
export FUNCTIONAL_INPUT_DIR="${FUNCTIONAL_INPUT_DIR:-$MAGENTA_DATA_DIR/functional}"
export FUNCTIONAL_OUTPUT_DIR="${FUNCTIONAL_OUTPUT_DIR:-$BIOGEOGRAPHY_RESULTS/functional}"
export FUNCTIONAL_FIGURE_DIR="${FUNCTIONAL_FIGURE_DIR:-$BIOGEOGRAPHY_BASE/figures/functional}"
export FUNCTIONAL_SAMPLE_MANIFEST="${FUNCTIONAL_SAMPLE_MANIFEST:-$BIOGEOGRAPHY_BASE/config/samples/functional_accessions.txt}"
export FUNCTIONAL_REGIONAL_OUTPUT_DIR="${FUNCTIONAL_REGIONAL_OUTPUT_DIR:-$BIOGEOGRAPHY_RESULTS/functional_regional_full}"
export WORLD_MAP="${WORLD_MAP:-$MAGENTA_DATA_DIR/maps/ne_110m_admin_0_countries.geojson}"
