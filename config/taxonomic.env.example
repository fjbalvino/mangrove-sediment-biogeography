# Run from the repository root or supply its absolute path.
export BIOGEOGRAPHY_BASE="$(pwd)"
export BIOGEOGRAPHY_RESULTS="$BIOGEOGRAPHY_BASE/results"
export MAGENTA_PHYLOSEQ="$BIOGEOGRAPHY_BASE/data/phyloseq_taxonomic.rds"
export MAGENTA_METADATA_CSV="$BIOGEOGRAPHY_BASE/data/metadata_taxonomic.csv"
export ALPHA_SAMPLE_MANIFEST="$BIOGEOGRAPHY_BASE/config/samples/taxonomic_accessions.txt"
export CORE_SAMPLE_MANIFEST="$ALPHA_SAMPLE_MANIFEST"

# iCAMP retains its separately completed analysis and is not repeated by workflow 03.
export ICAMP_PHYLOSEQ="$BIOGEOGRAPHY_BASE/data/icamp_taxonomic_counts.rds"
export TREE_FILE="$BIOGEOGRAPHY_BASE/data/genus_phylogeny_GTDB_R226_bac120.newick"

# Optional executable and package locations.
# export R_BIN="/path/to/Rscript"
# export R_LIBS_USER="/path/to/R/library"
