# Run from the repository root, or replace this value with its absolute path.
export BIOGEOGRAPHY_BASE="$(pwd)"
export BIOGEOGRAPHY_RESULTS="$BIOGEOGRAPHY_BASE/results"

# Frozen data files described in DATA_AVAILABILITY.md.
export MAGENTA_PHYLOSEQ_405="$BIOGEOGRAPHY_BASE/data/taxonomic_counts.rds"
export MAGENTA_PHYLOSEQ_401="$BIOGEOGRAPHY_BASE/data/taxonomic_core_counts.rds"
export MAGENTA_METADATA_CSV="$BIOGEOGRAPHY_BASE/data/environmental_metadata.csv"
export ALPHA_SAMPLE_MANIFEST="$BIOGEOGRAPHY_BASE/config/samples/taxonomic_diversity_accessions.txt"
export TREE_FILE="$BIOGEOGRAPHY_BASE/data/genus_phylogeny_GTDB_R226_bac120.newick"
export CORE_SAMPLE_MANIFEST="$BIOGEOGRAPHY_BASE/config/samples/taxonomic_core_accessions.txt"

# Optional: use a specific Rscript executable or an existing user package library.
# export R_BIN="/path/to/Rscript"
# export R_LIBS_USER="/path/to/R/library"
